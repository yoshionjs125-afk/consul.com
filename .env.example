# ---------------------------------------------------------------------------
# Neutral Consultation Platform — environment template
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Phase 1 runs Stripe in TEST mode only (FR-50, FR-55). No live keys, no real payouts.
# ---------------------------------------------------------------------------

# Supabase (Auth / DB / Storage) — FR-01
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect (TEST keys only in Phase 1) — FR-50, FR-55
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Platform fee bounds are defined in code (src/config/constants.ts), not here,
# so business rules stay testable and centralized (NFR-02).
